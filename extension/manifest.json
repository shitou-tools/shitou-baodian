{
  "manifest_version": 3,
  "name": "石头宝典",
  "version": "1.3.3",
  "description": "石头宝典 Token烧出来的提示词。本地收藏、分类、搜索、备注、草稿与回收站，可选阿里云 OSS 自动备份和历史恢复。",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "contextMenus",
    "clipboardWrite",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开石头宝典",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "manager.html",
    "open_in_tab": true
  },
  "commands": {
    "open-library": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "打开石头宝典侧栏"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "key": "",
  "optional_host_permissions": [
    "https://*.fcapp.run/*",
    "https://*.fc.aliyuncs.com/*"
  ]
}
